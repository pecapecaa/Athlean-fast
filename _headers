# Cloudflare Pages reads this file and applies these headers when it serves.
#
# The site had none, which meant every asset was revalidated on every visit and
# the edge cache did far less than it could. Under real traffic that is the
# difference between serving a page from the nearest city and rebuilding it
# from the origin each time.
#
# The rule behind the numbers below: a file whose URL changes when its content
# changes may be cached forever; a file whose URL stays the same while its
# content changes may not.
#
#   CSS and JS  — always requested with ?v=N from the HTML, and that number is
#                 bumped on every edit, so a new file is a new URL. Immutable.
#   Fonts       — content is fixed for the life of the typeface. Immutable.
#   Video       — the hero clip, replaced roughly never. A year.
#   Images      — NOT versioned: a photograph can be replaced under the same
#                 filename, which is exactly what happened to the bundle shots
#                 once already. Thirty days with revalidation in the
#                 background, so a swap is picked up within the month and the
#                 visitor never waits for the check. Renaming the file (or
#                 adding -v2) still remains the way to force it instantly.
#   HTML        — must never be cached: it carries the ?v=N numbers that
#                 release everything else. Cached HTML would pin a visitor to
#                 an old set of assets no matter how many times they reload.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# ---- HTML: always revalidate ----
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/vino.html
  Cache-Control: public, max-age=0, must-revalidate
/paket.html
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# ---- Versioned code: cache for a year ----
/styles.css
  Cache-Control: public, max-age=31536000, immutable
/vino.css
  Cache-Control: public, max-age=31536000, immutable
/script.js
  Cache-Control: public, max-age=31536000, immutable
/data.js
  Cache-Control: public, max-age=31536000, immutable
/vino.js
  Cache-Control: public, max-age=31536000, immutable
/paket.js
  Cache-Control: public, max-age=31536000, immutable
/wine-details.js
  Cache-Control: public, max-age=31536000, immutable
/bundle-details.js
  Cache-Control: public, max-age=31536000, immutable

# ---- Fonts and video: fixed content ----
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/videos/*
  Cache-Control: public, max-age=31536000, immutable

# ---- Photographs: replaceable under the same name ----
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/favicon-32.png
  Cache-Control: public, max-age=2592000
/favicon-180.png
  Cache-Control: public, max-age=2592000
