# Cloudflare Pages reads this file and applies these headers when it serves.
# (GitHub Pages ignores it.)
#
# The rule behind the numbers below: a file whose URL changes when its content
# changes may be cached forever; a file whose URL stays the same may not.
#
#   CSS and JS  — always requested with ?v=N from the HTML, and that number is
#                 bumped on every edit, so a new file is a new URL. Immutable.
#   Video       — the hero and level clips, replaced rarely. A year.
#   Images      — NOT versioned: a photo can be replaced under the same name.
#                 Thirty days with revalidation in the background.
#   HTML        — never cached: it carries the ?v=N numbers that release
#                 everything else.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# ---- HTML: always revalidate ----
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/nivo.html
  Cache-Control: public, max-age=0, must-revalidate
/program.html
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# ---- Versioned code: cache for a year ----
/styles.css
  Cache-Control: public, max-age=31536000, immutable
/detail.css
  Cache-Control: public, max-age=31536000, immutable
/data.js
  Cache-Control: public, max-age=31536000, immutable
/components.js
  Cache-Control: public, max-age=31536000, immutable
/script.js
  Cache-Control: public, max-age=31536000, immutable
/detail.js
  Cache-Control: public, max-age=31536000, immutable
/nivo.js
  Cache-Control: public, max-age=31536000, immutable
/program.js
  Cache-Control: public, max-age=31536000, immutable

# ---- Video: fixed content ----
/videos/*
  Cache-Control: public, max-age=31536000, immutable

# ---- Images: replaceable under the same name ----
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/favicon-32.png
  Cache-Control: public, max-age=2592000
/favicon-180.png
  Cache-Control: public, max-age=2592000
